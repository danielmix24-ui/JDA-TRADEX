    /* REQUERIMIENTO 1: Cálculo exacto de USDT Real y Remesa neta al Administrador */
    window.calcRemesa = function() {
        const trayecto = document.getElementById('rm-trayecto').value;
        const monto = parseFloat(document.getElementById('rm-monto').value) || 0;
        const tasa = parseFloat(document.getElementById('rm-tasa').value) || 0;
        const gananciaVendedorManual = parseFloat(document.getElementById('rm-ganancia-vendedor-manual').value) || 0;

        const key = routeKeyMap[trayecto] || "usa";
        const cfgPais = (variablesGlobales.pais_config && variablesGlobales.pais_config[key]) ? variablesGlobales.pais_config[key] : { ml: 1, vend: 0, admin: 6 };

        let usdtRef = 0;
        let neto = 0;

        if (trayecto.endsWith("_VE")) {
            // Moneda extranjera enviada a Venezuela (Ej: 100 USD / 1 = 100 USDT | 500 BRL / 5.13 = 97.46 USDT)
            const tasaPaisMl = (cfgPais.ml && cfgPais.ml > 0) ? cfgPais.ml : 1.0;
            usdtRef = monto / tasaPaisMl;
            neto = monto * tasa;
        } else {
            // Salida de Venezuela
            usdtRef = monto / (variablesGlobales.usdt_ves || 46.20);
            neto = monto / (tasa > 0 ? tasa : 1);
        }

        const pctAdmin = cfgPais.admin || 0;
        const usdtAdmin = usdtRef * (pctAdmin / 100);

        // El vendedor solo resta su ganancia asignada en % y envía el resto al admin
        const ganVendedorUSDT = usdtRef * (gananciaVendedorManual / 100);
        const enviarAdminNeto = usdtRef - ganVendedorUSDT;

        document.getElementById('rm-usdt-ref').value = usdtRef.toFixed(2);
        document.getElementById('rm-usdt-admin').value = usdtAdmin.toFixed(2) + " USDT";
        document.getElementById('rm-enviar-admin-neto').value = enviarAdminNeto.toFixed(2) + " USDT";
        document.getElementById('rm-neto').value = neto.toFixed(2);
    };

