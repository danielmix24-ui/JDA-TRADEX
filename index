    function renderizarTablaRemesas() {
        const tbody = document.getElementById('remesas-tbody');
        if(!tbody) return; tbody.innerHTML = "";

        const texto = (document.getElementById('buscar-remesa-input')?.value || "").toLowerCase();
        const rolActivo = localStorage.getItem("tradex_rol_activo") || "Vendedor";

        let listaFiltrada = historialRemesas.filter(r => {
            const mText = (r.id + " " + r.cliente + " " + r.destinatario + " " + r.vendedor + " " + r.trayecto).toLowerCase();
            return mText.includes(texto);
        });

        if(filtroRemesasActivo === "procesando") {
            listaFiltrada = listaFiltrada.filter(r => r.estado === "Procesando");
        } else if(filtroRemesasActivo === "hoy") {
            const hoy = new Date().toLocaleDateString('es-VE');
            listaFiltrada = listaFiltrada.filter(r => r.fecha && r.fecha.includes(hoy));
        }

        let sumaMontoAAdmin = 0;

        listaFiltrada.forEach(rem => {
            if(rem.estado !== "Cancelada") {
                sumaMontoAAdmin += (parseFloat(rem.enviarAdminNeto) || 0);
            }

            let badgeClass = "badge-procesando";
            if(rem.estado === "Procesada") badgeClass = "badge-procesada";
            if(rem.estado === "Cancelada") badgeClass = "badge-cancelada";

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${rem.id}</strong><br><small style="color:var(--muted);">${rem.fecha}</small></td>
                <td>${rem.trayecto}</td>
                <td>${rem.monto}</td>
                <td><strong>${rem.neto}</strong></td>
                <td>${rem.cliente}</td>
                <td><span class="badge ${badgeClass}">${rem.estado}</span></td>
                <td>
                    <button class="btn btn-g btn-sm" onclick="verOrden('${rem.firebaseUrlKey}')">👁️ Ver/Compartir</button>
                    ${rolActivo === "Administrador" ? `
                        <button class="btn btn-success btn-sm" onclick="actualizarEstadoRemesa('${rem.firebaseUrlKey}', 'Procesada')">✅</button>
                        <button class="btn btn-danger btn-sm" onclick="actualizarEstadoRemesa('${rem.firebaseUrlKey}', 'Cancelada')">❌</button>
                    ` : ''}
                </td>
            `;
            tbody.appendChild(tr);
        });

        const totalAdminBox = document.getElementById('monto-vendedor-a-administrador');
        if(totalAdminBox) totalAdminBox.innerText = sumaMontoAAdmin.toFixed(2) + " USDT";
    }

    function calcularGananciasDelDia() {
        const hoy = new Date().toLocaleDateString('es-VE');
        let totalUSDTHoy = 0;
        let totalVendHoy = 0;
        let totalAdminHoy = 0;

        historialRemesas.forEach(rem => {
            if(rem.fecha && rem.fecha.includes(hoy) && rem.estado !== "Cancelada") {
                totalUSDTHoy += (parseFloat(rem.usdtRef) || 0);
                totalVendHoy += ((parseFloat(rem.usdtRef) || 0) * ((parseFloat(rem.gananciaVendPct) || 0) / 100));
                totalAdminHoy += (parseFloat(rem.usdtAdmin) || 0);
            }
        });

        if(document.getElementById('dash-ganancias-hoy')) document.getElementById('dash-ganancias-hoy').innerText = totalUSDTHoy.toFixed(2) + " USDT";
        if(document.getElementById('dash-hoy-val')) document.getElementById('dash-hoy-val').innerText = historialRemesas.filter(r => r.estado === "Procesando").length;
        if(document.getElementById('dash-mes-val')) document.getElementById('dash-mes-val').innerText = historialRemesas.filter(r => r.estado === "Procesada").length;

        if(document.getElementById('total-vendedor-modal-val')) document.getElementById('total-vendedor-modal-val').innerText = totalVendHoy.toFixed(2) + " USDT";
        if(document.getElementById('total-admin-modal-val')) document.getElementById('total-admin-modal-val').innerText = totalAdminHoy.toFixed(2) + " USDT";
    }

