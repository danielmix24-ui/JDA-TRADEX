    };

    function renderizarTablaRecargas() {
        const tbody = document.getElementById('recargas-tbody');
        if(!tbody) return; tbody.innerHTML = "";
        historialRecargas.forEach(r => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${r.fecha}</td>
                <td><strong>${r.cliente}</strong></td>
                <td>${r.operadora}</td>
                <td>${r.telefono}</td>
                <td>$${parseFloat(r.monto).toFixed(2)}</td>
                <td><span class="badge badge-procesada">${r.estado}</span></td>
                <td><button class="btn btn-g btn-sm">📱 Ver</button></td>
            `;
            tbody.appendChild(tr);
        });
    }

    /* ARQUEO DE CAJA Y BANCOS */
    window.registrarMovementoCaja = function() {
        const tipo = document.getElementById('cj-tipo').value;
        const monto = parseFloat(document.getElementById('cj-monto').value) || 0;
        const concepto = document.getElementById('cj-concepto').value.trim();

        if(!monto || !concepto) { alert("Monto y concepto son obligatorios."); return; }

        push(ref(db, 'caja_diaria'), {
            tipo: tipo, monto: monto, concepto: concepto,
            hora: new Date().toLocaleTimeString('es-VE', {hour:'2-digit', minute:'2-digit'})
        }).then(() => {
            document.getElementById('cj-monto').value = "";
            document.getElementById('cj-concepto').value = "";
            pushNotification("🗄️ Movimiento de caja registrado.");
        });
    };

    window.guardarBaseAperturaCaja = function() {
        const val = parseFloat(document.getElementById('cj-apertura').value) || 0;
        set(ref(db, 'caja_apertura_base'), val);
    };

    function calcularFlujoCajaTotal() {
        let ing = 0; let eg = 0;
        historialCaja.forEach(c => {
            if(c.tipo === "Ingreso") ing += (parseFloat(c.monto) || 0);
            else eg += (parseFloat(c.monto) || 0);
        });

        const saldoNeto = baseAperturaCajaGlobal + ing - eg;

        if(document.getElementById('total-ingresos-box')) document.getElementById('total-ingresos-box').innerText = "Bs. " + ing.toFixed(2);
        if(document.getElementById('total-egresos-box')) document.getElementById('total-egresos-box').innerText = "Bs. " + eg.toFixed(2);
        if(document.getElementById('saldo-caja-box')) document.getElementById('saldo-caja-box').innerText = "Bs. " + saldoNeto.toFixed(2);
    }

    function renderizarTablaCaja() {
        const tbody = document.getElementById('caja-tbody');
        if(!tbody) return; tbody.innerHTML = "";
        historialCaja.forEach(c => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${c.hora}</td>
                <td><span class="badge ${c.tipo === 'Ingreso' ? 'badge-procesada' : 'badge-cancelada'}">${c.tipo}</span></td>
                <td>${c.concepto}</td>
                <td><strong>Bs. ${parseFloat(c.monto).toFixed(2)}</strong></td>
            `;
            tbody.appendChild(tr);
        });
        calcularFlujoCajaTotal();
    }

    window.registrarBanco = function() {
        const plat = document.getElementById('bn-plataforma').value.trim();
        const iden = document.getElementById('bn-identificador').value.trim();
        const sald = parseFloat(document.getElementById('bn-saldo').value) || 0;

        if(!plat || !iden) { alert("Plataforma e identificador requeridos."); return; }

        push(ref(db, 'bancos'), { plataforma: plat, identificador: iden, saldo: sald })
            .then(() => {
                document.getElementById('bn-plataforma').value = "";
                document.getElementById('bn-identificador').value = "";
                document.getElementById('bn-saldo').value = "";
                pushNotification("🏦 Banco sincronizado.");
            });
    };

    function renderizarTablaBancos() {
        const tbody = document.getElementById('bancos-tbody');
        if(!tbody) return; tbody.innerHTML = "";
        listaBancos.forEach(b => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${b.plataforma}</strong></td>
                <td>${b.identificador}</td>
                <td><strong style="color:var(--gold);">$${parseFloat(b.saldo).toFixed(2)}</strong></td>
                <td><button class="btn btn-danger btn-sm" onclick="eliminarBanco('${b.firebaseUrlKey}')">🗑️</button></td>
            `;
            tbody.appendChild(tr);
        });
    }

    window.eliminarBanco = function(key) {
        if(confirm("¿Eliminar este registro bancario?")) {
            remove(ref(db, `bancos/${key}`)).then(() => pushNotification("🏦 Banco removido."));
        }
    };
  </script>
</body>
</html>
